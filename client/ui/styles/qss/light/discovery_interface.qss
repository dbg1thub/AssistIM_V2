QWidget#DiscoveryInterface,
QWidget#MomentCommentSection,
QWidget#discoveryScrollWidget,
QWidget#discoveryViewport,
QWidget#discoveryColumn,
QWidget#discoveryFeedContainer,
QWidget#MomentsFeedList,
QListView#MomentsRightListView,
QWidget#MomentsRightContent {
    background: transparent;
}

QSplitter#momentsSplitter {
    background: transparent;
    border: none;
}

QSplitter#momentsSplitter::handle:horizontal {
    background: transparent;
    border: none;
    margin: 0;
}

QWidget#MomentsLeftPanel {
    background: {{SURFACE_BG}};
    border: none;
}

QWidget#MomentsFeedPanel {
    background: {{SURFACE_BG}};
}

QWidget#MomentsRightPanel {
    background: {{CARD_BG_STRONG}};
    border: none;
}

QWidget#MomentsProfileBlock {
    background: transparent;
    border: none;
}

QFrame#MomentsCoverBanner {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #b5d4f4, stop:1 #9fe1cb);
    border-radius: {{RADIUS_CARD}};
}

QWidget#MomentsProfileIdentityRow {
    background: transparent;
}

QLabel#MomentsProfileNameLabel,
QLabel#MomentsFeedTitle {
    color: {{TEXT_PRIMARY}};
    font: 600 13px "Segoe UI", "Microsoft YaHei", "PingFang SC";
}

QLabel#MomentsProfileBioLabel,
QLabel#MomentsProfileStatLabel {
    color: {{TEXT_SECONDARY}};
    font: 11px "Segoe UI", "Microsoft YaHei", "PingFang SC";
}

QListView#MomentsRightListView {
    border: none;
    color: {{TEXT_SECONDARY}};
    font: 11px "Segoe UI", "Microsoft YaHei", "PingFang SC";
    outline: none;
}

QListView#MomentsRightListView::item {
    padding: 3px 0px;
    background: transparent;
    border: none;
}

QLabel#MomentsProfileStatValue {
    color: {{TEXT_PRIMARY}};
    font: 600 14px "Segoe UI", "Microsoft YaHei", "PingFang SC";
}

QWidget#MomentsLeftFooter {
    background: transparent;
    border: none;
}

QFrame#MomentsNavItem {
    background: transparent;
    border: none;
    border-radius: 0px;
}

QFrame#MomentsNavItem:hover,
QFrame#MomentsNavItem[active="true"] {
    background: rgba(0, 0, 0, 10);
}

QLabel#momentsNavItemText {
    color: {{TEXT_SECONDARY}};
    font: 13px "Segoe UI", "Microsoft YaHei", "PingFang SC";
}

QWidget#MomentsFeedToolbar,
QWidget#MomentsComposeBar {
    background: {{CARD_BG_STRONG}};
    border: none;
}

SegmentedWidget#MomentsFeedFilter {
    background: transparent;
    border: none;
}

QLabel#MomentsComposeInput {
    background: {{SURFACE_BG}};
    border: 1px solid {{BORDER_COLOR}};
    border-radius: {{RADIUS_CARD}};
    padding: 7px 12px;
    color: {{TEXT_SECONDARY}};
}

QLabel#MomentsRightSectionTitle,
QLabel#MomentsDigestLabel {
    color: {{TEXT_SECONDARY}};
    font: 600 11px "Segoe UI", "Microsoft YaHei", "PingFang SC";
}

QFrame#MomentsDigestCard {
    background: {{SURFACE_BG}};
    border: 1px solid {{BORDER_COLOR}};
    border-radius: {{RADIUS_CARD}};
}

QWidget#MomentCard {
    background: {{CARD_BG_STRONG}};
    border: none;
    border-radius: 0px;
}

QWidget#MomentCardHeaderRow,
QWidget#MomentCardContentRow,
QWidget#MomentCardActionRow,
QWidget#MomentCardIdentityArea,
QWidget#MomentCardHeaderActions,
QWidget#MomentCardLikeArea {
    background: transparent;
    border: none;
}

QLabel#momentContentLabel {
    color: {{TEXT_PRIMARY}};
}

QWidget#momentMediaGrid {
    border: none;
}

QFrame#MomentCardDivider {
    background: {{BORDER_COLOR}};
    min-height: 1px;
    max-height: 1px;
    border: none;
}

QFrame#MomentCommentSurface {
    background: {{SURFACE_BG}};
    border: 1px solid {{BORDER_COLOR}};
    border-radius: {{RADIUS_CARD}};
}

QLabel#momentCommentTimeLabel,
QLabel#momentStatsLabel {
    color: {{TEXT_SECONDARY}};
    font: 12px "Segoe UI", "Microsoft YaHei", "PingFang SC";
}

QLabel#momentImageCard,
QLabel#momentVideoCard {
    background: {{TILE_BG}};
    border: 1px solid {{TILE_BORDER}};
    border-radius: {{RADIUS_CARD}};
    color: {{TILE_TEXT}};
    font: 12px "Segoe UI", "Microsoft YaHei", "PingFang SC";
}

QFrame#ToggleBadge {
    background: {{SURFACE_BG}};
    border: none;
    border-radius: 10px;
}

QFrame#ToggleBadge[hoverEnabled="true"]:hover {
    background: {{CARD_BG_STRONG}};
}

QFrame#ToggleBadge[pressEnabled="true"][pressed="true"] {
    background: {{BORDER_COLOR}};
}

QFrame#ToggleBadge[checked="true"] {
    background: rgba(252, 235, 235, 0.96);
    border: 1px solid rgba(240, 149, 149, 0.92);
}

QFrame#ToggleBadge[checked="true"][hoverEnabled="true"]:hover {
    background: rgba(250, 218, 218, 0.98);
    border: 1px solid rgba(224, 102, 102, 0.95);
}

QFrame#ToggleBadge[borderVisible="false"],
QFrame#ToggleBadge[borderVisible="false"][hoverEnabled="true"]:hover,
QFrame#ToggleBadge[borderVisible="false"][pressEnabled="true"][pressed="true"],
QFrame#ToggleBadge[borderVisible="false"][checked="true"] {
    border: none;
}

QLabel#ToggleBadgeText {
    color: {{TEXT_SECONDARY}};
    font: 12px "Segoe UI", "Microsoft YaHei", "PingFang SC";
}

QFrame#ToggleBadge[checked="true"] QLabel#ToggleBadgeText {
    color: rgb(121, 31, 31);
}

QAbstractScrollArea {
    background: transparent;
    border: none;
}
